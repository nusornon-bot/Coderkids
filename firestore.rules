rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // -------------------------------------------------------------------------
    // Global Safety Net (Default-Deny Catch-All)
    // -------------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Shared Hardened Security Primitives
    // -------------------------------------------------------------------------
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidRoomCode(code) {
      return code is string && code.size() >= 4 && code.size() <= 12 && code.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidVirtualRoomCode(code) {
      return code is string && code.size() >= 3 && code.size() <= 20 && code.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isGuestParticipantId(id) {
      return id is string && id.size() >= 14 && id.size() <= 72 && id.matches('^guest_[a-zA-Z0-9_\\-]+$');
    }

    function isActiveLiveRoom(roomCode) {
      return exists(/databases/$(database)/documents/liveRooms/$(roomCode)) &&
        get(/databases/$(database)/documents/liveRooms/$(roomCode)).data.status == 'active';
    }

    function isLiveRoomAcceptingAnswers(roomCode) {
      return exists(/databases/$(database)/documents/liveRooms/$(roomCode)) &&
        get(/databases/$(database)/documents/liveRooms/$(roomCode)).data.status == 'active' &&
        get(/databases/$(database)/documents/liveRooms/$(roomCode)).data.stage != 'podium';
    }

    function isLiveRoomHost(roomCode) {
      return isEmailVerified() &&
        exists(/databases/$(database)/documents/liveRooms/$(roomCode)) &&
        get(/databases/$(database)/documents/liveRooms/$(roomCode)).data.hostUid == request.auth.uid;
    }

    function isActiveVirtualRoom(roomCode) {
      return exists(/databases/$(database)/documents/virtualClassrooms/$(roomCode)) &&
        get(/databases/$(database)/documents/virtualClassrooms/$(roomCode)).data.status == 'active';
    }

    function isVirtualRoomHost(roomCode) {
      return isEmailVerified() &&
        exists(/databases/$(database)/documents/virtualClassrooms/$(roomCode)) &&
        get(/databases/$(database)/documents/virtualClassrooms/$(roomCode)).data.hostUid == request.auth.uid;
    }

    function isOwner(userId) {
      return isEmailVerified() && request.auth.uid == userId;
    }

    function isBootstrappedAdminEmail() {
      return isEmailVerified() &&
        request.auth.token.email in [
          'webmaster@anubalnara.ac.th',
          'nusorn.not@anubalnara.ac.th',
          'nusornon@gmail.com'
        ];
    }

    function isAdmin() {
      return isEmailVerified() && (
        isBootstrappedAdminEmail() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // -------------------------------------------------------------------------
    // Entity Validation Blueprints (Anti-Update-Gap)
    // -------------------------------------------------------------------------
    function isValidUserPublicProfile(data, userId) {
      return data.keys().hasAll([
          'uid',
          'displayName',
          'avatarEmoji',
          'grade',
          'school',
          'points',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid',
          'displayName',
          'nickname',
          'avatarEmoji',
          'grade',
          'school',
          'points',
          'codingLevel',
          'selectedTitle',
          'streakDays',
          'completedModulesCount',
          'createdAt',
          'updatedAt'
        ]) &&
        data.uid is string && isValidId(data.uid) && data.uid == userId &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120 &&
        (!('nickname' in data) || (data.nickname is string && data.nickname.size() <= 60)) &&
        data.avatarEmoji is string && data.avatarEmoji.size() >= 1 && data.avatarEmoji.size() <= 16 &&
        data.grade is string && data.grade.size() >= 1 && data.grade.size() <= 60 &&
        data.school is string && data.school.size() >= 1 && data.school.size() <= 120 &&
        data.points is int && data.points >= 0 && data.points <= 1000000 &&
        (!('codingLevel' in data) || (data.codingLevel is string && data.codingLevel in ['Beginner', 'Intermediate', 'Advanced'])) &&
        (!('selectedTitle' in data) || (data.selectedTitle is string && data.selectedTitle.size() <= 100)) &&
        (!('streakDays' in data) || (data.streakDays is int && data.streakDays >= 0 && data.streakDays <= 3650)) &&
        (!('completedModulesCount' in data) || (data.completedModulesCount is int && data.completedModulesCount >= 0 && data.completedModulesCount <= 20)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidUserPrivateInfo(data, userId) {
      return data.keys().hasAll(['uid', 'role', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly([
          'uid',
          'studentId',
          'contactEmail',
          'bio',
          'motto',
          'role',
          'createdAt',
          'updatedAt'
        ]) &&
        data.uid is string && isValidId(data.uid) && data.uid == userId &&
        (!('studentId' in data) || (data.studentId is string && data.studentId.size() <= 64)) &&
        (!('contactEmail' in data) || (data.contactEmail is string && data.contactEmail.size() <= 160)) &&
        (!('bio' in data) || (data.bio is string && data.bio.size() <= 400)) &&
        (!('motto' in data) || (data.motto is string && data.motto.size() <= 200)) &&
        data.role is string && data.role in ['student', 'teacher'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidSavedFlowchart(data, userId) {
      return data.keys().hasAll([
          'ownerId',
          'title',
          'displayMode',
          'snapToGrid',
          'nodes',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId',
          'title',
          'missionId',
          'templateId',
          'displayMode',
          'snapToGrid',
          'nodes',
          'createdAt',
          'updatedAt'
        ]) &&
        data.ownerId is string && isValidId(data.ownerId) && data.ownerId == userId &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 140 &&
        (!('missionId' in data) || (data.missionId is string && data.missionId.size() <= 64)) &&
        (!('templateId' in data) || (data.templateId is string && data.templateId.size() <= 64)) &&
        data.displayMode is string && data.displayMode in ['visual', 'text'] &&
        data.snapToGrid is bool &&
        data.nodes is list && data.nodes.size() >= 1 && data.nodes.size() <= 100 &&
        data.nodes[0] is map &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidStudioProject(data, userId) {
      return data.keys().hasAll([
          'ownerId',
          'studioType',
          'title',
          'codeContent',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId',
          'studioType',
          'title',
          'presetId',
          'codeContent',
          'blocksJson',
          'createdAt',
          'updatedAt'
        ]) &&
        data.ownerId is string && isValidId(data.ownerId) && data.ownerId == userId &&
        data.studioType is string && data.studioType in ['scratch', 'microbit', 'python'] &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 140 &&
        (!('presetId' in data) || (data.presetId is string && data.presetId.size() <= 64)) &&
        data.codeContent is string && data.codeContent.size() >= 1 && data.codeContent.size() <= 20000 &&
        (!('blocksJson' in data) || (data.blocksJson is string && data.blocksJson.size() <= 30000)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidShowcaseProject(data) {
      return data.keys().hasAll([
          'ownerId',
          'authorName',
          'category',
          'title',
          'description',
          'likesCount',
          'status',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId',
          'authorName',
          'authorAvatar',
          'grade',
          'category',
          'title',
          'description',
          'projectUrl',
          'likesCount',
          'status',
          'createdAt',
          'updatedAt'
        ]) &&
        data.ownerId is string && isValidId(data.ownerId) &&
        data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 120 &&
        (!('authorAvatar' in data) || (data.authorAvatar is string && data.authorAvatar.size() <= 16)) &&
        (!('grade' in data) || (data.grade is string && data.grade.size() <= 40)) &&
        data.category is string && data.category in ['Scratch', 'Micro:bit', 'Python', 'Flowchart'] &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 140 &&
        data.description is string && data.description.size() >= 1 && data.description.size() <= 1000 &&
        (!('projectUrl' in data) || (data.projectUrl is string && data.projectUrl.size() <= 400)) &&
        data.likesCount is int && data.likesCount >= 0 && data.likesCount <= 1000000 &&
        data.status is string && data.status in ['published', 'archived'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidPeerReview(data, projectId) {
      return data.keys().hasAll([
          'projectId',
          'reviewerId',
          'reviewerName',
          'star1',
          'wish',
          'createdAt'
        ]) &&
        data.keys().hasOnly([
          'projectId',
          'reviewerId',
          'reviewerName',
          'star1',
          'star2',
          'wish',
          'createdAt'
        ]) &&
        data.projectId is string && isValidId(data.projectId) && data.projectId == projectId &&
        data.reviewerId is string && isValidId(data.reviewerId) &&
        data.reviewerName is string && data.reviewerName.size() >= 1 && data.reviewerName.size() <= 120 &&
        data.star1 is string && data.star1.size() >= 1 && data.star1.size() <= 300 &&
        (!('star2' in data) || (data.star2 is string && data.star2.size() <= 300)) &&
        data.wish is string && data.wish.size() >= 1 && data.wish.size() <= 300 &&
        data.createdAt is timestamp;
    }

    function isValidHomeworkSubmission(data) {
      return data.keys().hasAll([
          'ownerId',
          'studentName',
          'studentClass',
          'topic',
          'title',
          'reflection',
          'status',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId',
          'studentName',
          'studentClass',
          'topic',
          'title',
          'projectUrl',
          'reflection',
          'status',
          'gradeScore',
          'teacherFeedback',
          'createdAt',
          'updatedAt'
        ]) &&
        data.ownerId is string && isValidId(data.ownerId) &&
        data.studentName is string && data.studentName.size() >= 1 && data.studentName.size() <= 120 &&
        data.studentClass is string && data.studentClass.size() >= 1 && data.studentClass.size() <= 60 &&
        data.topic is string && data.topic.size() >= 1 && data.topic.size() <= 200 &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 160 &&
        (!('projectUrl' in data) || (data.projectUrl is string && data.projectUrl.size() <= 400)) &&
        data.reflection is string && data.reflection.size() <= 1000 &&
        data.status is string && data.status in ['pending', 'graded'] &&
        (!('gradeScore' in data) || (data.gradeScore is int && data.gradeScore >= 1 && data.gradeScore <= 5)) &&
        (!('teacherFeedback' in data) || (data.teacherFeedback is string && data.teacherFeedback.size() <= 600)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidLiveRoomTopWinner(entry) {
      return entry is map &&
        entry.keys().hasAll([
          'rank',
          'userId',
          'displayName',
          'avatar',
          'score',
          'streak',
          'xpReward'
        ]) &&
        entry.keys().hasOnly([
          'rank',
          'userId',
          'displayName',
          'avatar',
          'score',
          'streak',
          'xpReward'
        ]) &&
        entry.rank is int && entry.rank >= 1 && entry.rank <= 3 &&
        entry.userId is string && isValidId(entry.userId) &&
        entry.displayName is string && entry.displayName.size() >= 1 && entry.displayName.size() <= 120 &&
        entry.avatar is string && entry.avatar.size() >= 1 && entry.avatar.size() <= 16 &&
        entry.score is int && entry.score >= 0 && entry.score <= 100000 &&
        entry.streak is int && entry.streak >= 0 && entry.streak <= 100 &&
        entry.xpReward is int && entry.xpReward >= 0 && entry.xpReward <= 1000;
    }

    function isValidLiveQuizRoom(data, roomCode) {
      return data.keys().hasAll([
          'roomCode',
          'hostUid',
          'hostName',
          'title',
          'stage',
          'currentQuestionIndex',
          'status',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'roomCode',
          'hostUid',
          'hostName',
          'title',
          'stage',
          'currentQuestionIndex',
          'status',
          'platformSet',
          'difficulty',
          'questionCount',
          'questionIds',
          'totalParticipants',
          'finalTopWinners',
          'createdAt',
          'updatedAt'
        ]) &&
        data.roomCode is string && isValidRoomCode(data.roomCode) && data.roomCode == roomCode &&
        data.hostUid is string && isValidId(data.hostUid) &&
        data.hostName is string && data.hostName.size() >= 1 && data.hostName.size() <= 120 &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 140 &&
        data.stage is string && data.stage in ['lobby', 'question', 'reveal', 'podium'] &&
        data.currentQuestionIndex is int && data.currentQuestionIndex >= 0 && data.currentQuestionIndex <= 50 &&
        data.status is string && data.status in ['active', 'closed'] &&
        (!('platformSet' in data) || (data.platformSet is string && data.platformSet in ['Scratch', 'Micro:bit', 'mixed'])) &&
        (!('difficulty' in data) || (data.difficulty is string && data.difficulty in ['all', 'easy', 'medium', 'hard'])) &&
        (!('questionCount' in data) || (data.questionCount is int && data.questionCount >= 1 && data.questionCount <= 50)) &&
        (!('questionIds' in data) || (
          data.questionIds is list &&
          data.questionIds.size() >= 1 &&
          data.questionIds.size() <= 50 &&
          data.questionIds[0] is string &&
          data.questionIds[0].size() >= 1 &&
          data.questionIds[0].size() <= 128
        )) &&
        (!('totalParticipants' in data) || (data.totalParticipants is int && data.totalParticipants >= 0 && data.totalParticipants <= 500)) &&
        (!('finalTopWinners' in data) || (
          data.finalTopWinners is list &&
          data.finalTopWinners.size() <= 3 &&
          (data.finalTopWinners.size() < 1 || isValidLiveRoomTopWinner(data.finalTopWinners[0])) &&
          (data.finalTopWinners.size() < 2 || isValidLiveRoomTopWinner(data.finalTopWinners[1])) &&
          (data.finalTopWinners.size() < 3 || isValidLiveRoomTopWinner(data.finalTopWinners[2]))
        )) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidLiveQuizParticipant(data, roomCode, participantId) {
      return data.keys().hasAll([
          'roomCode',
          'userId',
          'displayName',
          'avatar',
          'score',
          'streak',
          'lastAnswerIndex',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'roomCode',
          'userId',
          'displayName',
          'avatar',
          'score',
          'streak',
          'lastAnswerIndex',
          'createdAt',
          'updatedAt'
        ]) &&
        data.roomCode is string && isValidRoomCode(data.roomCode) && data.roomCode == roomCode &&
        data.userId is string && isValidId(data.userId) && data.userId == participantId &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120 &&
        data.avatar is string && data.avatar.size() >= 1 && data.avatar.size() <= 16 &&
        data.score is int && data.score >= 0 && data.score <= 100000 &&
        data.streak is int && data.streak >= 0 && data.streak <= 100 &&
        data.lastAnswerIndex is int && data.lastAnswerIndex >= -1 && data.lastAnswerIndex <= 10 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidPorPor5Record(data) {
      return data.keys().hasAll([
          'studentId',
          'name',
          'gradeRoom',
          'pdpaScore',
          'logicScore',
          'codingScore',
          'showcaseScore',
          'totalScore',
          'status',
          'teacherUid',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'studentId',
          'name',
          'gradeRoom',
          'pdpaScore',
          'logicScore',
          'codingScore',
          'showcaseScore',
          'totalScore',
          'gradeLevel',
          'status',
          'teacherUid',
          'createdAt',
          'updatedAt'
        ]) &&
        data.studentId is string && data.studentId.size() >= 1 && data.studentId.size() <= 64 &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        data.gradeRoom is string && data.gradeRoom.size() >= 1 && data.gradeRoom.size() <= 40 &&
        data.pdpaScore is int && data.pdpaScore >= 0 && data.pdpaScore <= 100 &&
        data.logicScore is int && data.logicScore >= 0 && data.logicScore <= 100 &&
        data.codingScore is int && data.codingScore >= 0 && data.codingScore <= 100 &&
        data.showcaseScore is int && data.showcaseScore >= 0 && data.showcaseScore <= 100 &&
        data.totalScore is int && data.totalScore >= 0 && data.totalScore <= 100 &&
        (!('gradeLevel' in data) || (data.gradeLevel is string && data.gradeLevel.size() <= 40)) &&
        data.status is string && data.status in ['ผ่านเกณฑ์', 'รอพัฒนา', 'ดีเยี่ยม'] &&
        data.teacherUid is string && isValidId(data.teacherUid) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAdminRole(data, adminUid) {
      return data.keys().hasAll(['uid', 'email', 'role', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'email', 'role', 'createdAt']) &&
        data.uid is string && isValidId(data.uid) && data.uid == adminUid &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
        data.role is string && data.role in ['admin', 'teacher'] &&
        data.createdAt is timestamp;
    }

    function isValidBattleQuestion(data) {
      return data.keys().hasAll([
          'platform',
          'difficulty',
          'title',
          'codeSnippet',
          'options',
          'correctIndex',
          'explanation',
          'status',
          'createdByUid',
          'createdByName',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'platform',
          'difficulty',
          'title',
          'codeSnippet',
          'options',
          'correctIndex',
          'explanation',
          'status',
          'createdByUid',
          'createdByName',
          'createdAt',
          'updatedAt'
        ]) &&
        data.platform is string && data.platform in ['Scratch', 'Micro:bit'] &&
        data.difficulty is string && data.difficulty in ['easy', 'medium', 'hard'] &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
        data.codeSnippet is string && data.codeSnippet.size() >= 1 && data.codeSnippet.size() <= 1500 &&
        data.options is list && data.options.size() == 4 &&
        data.options[0] is string && data.options[0].size() >= 1 && data.options[0].size() <= 300 &&
        data.options[1] is string && data.options[1].size() >= 1 && data.options[1].size() <= 300 &&
        data.options[2] is string && data.options[2].size() >= 1 && data.options[2].size() <= 300 &&
        data.options[3] is string && data.options[3].size() >= 1 && data.options[3].size() <= 300 &&
        data.correctIndex is int && data.correctIndex >= 0 && data.correctIndex <= 3 &&
        data.explanation is string && data.explanation.size() >= 1 && data.explanation.size() <= 600 &&
        data.status is string && data.status in ['active', 'archived'] &&
        data.createdByUid is string && isValidId(data.createdByUid) &&
        data.createdByName is string && data.createdByName.size() >= 1 && data.createdByName.size() <= 120 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidVirtualClassroom(data, roomCode) {
      return data.keys().hasAll([
          'roomCode',
          'name',
          'teacherName',
          'hostUid',
          'grade',
          'school',
          'studentsCount',
          'status',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'roomCode',
          'name',
          'teacherName',
          'hostUid',
          'grade',
          'school',
          'description',
          'studentsCount',
          'status',
          'createdAt',
          'updatedAt'
        ]) &&
        data.roomCode is string && isValidVirtualRoomCode(data.roomCode) && data.roomCode == roomCode &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 140 &&
        data.teacherName is string && data.teacherName.size() >= 1 && data.teacherName.size() <= 120 &&
        data.hostUid is string && isValidId(data.hostUid) &&
        data.grade is string && data.grade.size() >= 1 && data.grade.size() <= 80 &&
        data.school is string && data.school.size() >= 1 && data.school.size() <= 120 &&
        (!('description' in data) || (data.description is string && data.description.size() <= 500)) &&
        data.studentsCount is int && data.studentsCount >= 0 && data.studentsCount <= 1000 &&
        data.status is string && data.status in ['active', 'archived'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidVirtualClassroomMember(data, roomCode, memberId) {
      return data.keys().hasAll([
          'roomCode',
          'memberId',
          'displayName',
          'avatarEmoji',
          'role',
          'joinedAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'roomCode',
          'memberId',
          'displayName',
          'avatarEmoji',
          'role',
          'joinedAt',
          'updatedAt'
        ]) &&
        data.roomCode is string && isValidVirtualRoomCode(data.roomCode) && data.roomCode == roomCode &&
        data.memberId is string && isValidId(data.memberId) && data.memberId == memberId &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120 &&
        data.avatarEmoji is string && data.avatarEmoji.size() >= 1 && data.avatarEmoji.size() <= 16 &&
        data.role is string && data.role in ['student', 'teacher'] &&
        data.joinedAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidVirtualClassroomAssignment(data, roomCode) {
      return data.keys().hasAll([
          'roomCode',
          'title',
          'moduleKey',
          'dueDate',
          'teacherNote',
          'rewardPoints',
          'maxScore',
          'createdByUid',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'roomCode',
          'title',
          'moduleKey',
          'dueDate',
          'teacherNote',
          'rewardPoints',
          'maxScore',
          'createdByUid',
          'createdAt',
          'updatedAt'
        ]) &&
        data.roomCode is string && isValidVirtualRoomCode(data.roomCode) && data.roomCode == roomCode &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
        data.moduleKey is string && data.moduleKey in ['safety', 'thinking', 'codingLab', 'showcase', 'general'] &&
        data.dueDate is string && data.dueDate.size() >= 1 && data.dueDate.size() <= 80 &&
        data.teacherNote is string && data.teacherNote.size() <= 1000 &&
        data.rewardPoints is int && data.rewardPoints >= 5 && data.rewardPoints <= 50 &&
        data.maxScore is int && data.maxScore >= 1 && data.maxScore <= 100 &&
        data.createdByUid is string && isValidId(data.createdByUid) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidVirtualClassroomSubmission(data, roomCode) {
      return data.keys().hasAll([
          'roomCode',
          'assignmentId',
          'studentMemberId',
          'studentName',
          'submissionText',
          'status',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'roomCode',
          'assignmentId',
          'studentMemberId',
          'studentName',
          'submissionText',
          'submissionUrl',
          'submissionFileName',
          'status',
          'score',
          'teacherFeedback',
          'createdAt',
          'updatedAt'
        ]) &&
        data.roomCode is string && isValidVirtualRoomCode(data.roomCode) && data.roomCode == roomCode &&
        data.assignmentId is string && isValidId(data.assignmentId) &&
        data.studentMemberId is string && isValidId(data.studentMemberId) &&
        data.studentName is string && data.studentName.size() >= 1 && data.studentName.size() <= 120 &&
        data.submissionText is string && data.submissionText.size() <= 1000 &&
        (!('submissionUrl' in data) || (data.submissionUrl is string && data.submissionUrl.size() <= 400)) &&
        (!('submissionFileName' in data) || (data.submissionFileName is string && data.submissionFileName.size() <= 200)) &&
        data.status is string && data.status in ['submitted', 'graded'] &&
        (!('score' in data) || (data.score is int && data.score >= 0 && data.score <= 100)) &&
        (!('teacherFeedback' in data) || (data.teacherFeedback is string && data.teacherFeedback.size() <= 600)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidVirtualClassroomSchedule(data, roomCode) {
      return data.keys().hasAll([
          'roomCode',
          'dayOfWeek',
          'dayLabel',
          'startTime',
          'endTime',
          'period',
          'subjectCode',
          'subjectName',
          'topic',
          'createdByUid',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'roomCode',
          'dayOfWeek',
          'dayLabel',
          'startTime',
          'endTime',
          'period',
          'subjectCode',
          'subjectName',
          'topic',
          'unitTitle',
          'roomLocation',
          'teacherName',
          'onlineMeetUrl',
          'colorTheme',
          'createdByUid',
          'createdAt',
          'updatedAt'
        ]) &&
        data.roomCode is string && isValidVirtualRoomCode(data.roomCode) && data.roomCode == roomCode &&
        data.dayOfWeek is string && data.dayOfWeek in ['monday', 'tuesday', 'wednesday', 'thursday', 'friday'] &&
        data.dayLabel is string && data.dayLabel.size() >= 1 && data.dayLabel.size() <= 40 &&
        data.startTime is string && data.startTime.size() >= 1 && data.startTime.size() <= 20 &&
        data.endTime is string && data.endTime.size() >= 1 && data.endTime.size() <= 20 &&
        data.period is int && data.period >= 1 && data.period <= 12 &&
        data.subjectCode is string && data.subjectCode.size() >= 1 && data.subjectCode.size() <= 40 &&
        data.subjectName is string && data.subjectName.size() >= 1 && data.subjectName.size() <= 120 &&
        data.topic is string && data.topic.size() >= 1 && data.topic.size() <= 200 &&
        (!('unitTitle' in data) || (data.unitTitle is string && data.unitTitle.size() <= 140)) &&
        (!('roomLocation' in data) || (data.roomLocation is string && data.roomLocation.size() <= 120)) &&
        (!('teacherName' in data) || (data.teacherName is string && data.teacherName.size() <= 120)) &&
        (!('onlineMeetUrl' in data) || (data.onlineMeetUrl is string && data.onlineMeetUrl.size() <= 400)) &&
        (!('colorTheme' in data) || (data.colorTheme is string && data.colorTheme.size() <= 80)) &&
        data.createdByUid is string && isValidId(data.createdByUid) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidVirtualClassroomMaterial(data, roomCode) {
      return data.keys().hasAll([
          'roomCode',
          'title',
          'description',
          'fileType',
          'fileTypeLabel',
          'fileName',
          'uploadedBy',
          'downloadsCount',
          'createdByUid',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'roomCode',
          'title',
          'description',
          'fileType',
          'fileTypeLabel',
          'fileName',
          'fileSize',
          'externalUrl',
          'uploadedBy',
          'unitTopic',
          'tags',
          'previewSnippet',
          'downloadsCount',
          'createdByUid',
          'createdAt',
          'updatedAt'
        ]) &&
        data.roomCode is string && isValidVirtualRoomCode(data.roomCode) && data.roomCode == roomCode &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
        data.description is string && data.description.size() <= 800 &&
        data.fileType is string && data.fileType in ['pdf', 'slides', 'worksheet', 'code', 'video', 'link'] &&
        data.fileTypeLabel is string && data.fileTypeLabel.size() >= 1 && data.fileTypeLabel.size() <= 80 &&
        data.fileName is string && data.fileName.size() >= 1 && data.fileName.size() <= 160 &&
        (!('fileSize' in data) || (data.fileSize is string && data.fileSize.size() <= 40)) &&
        (!('externalUrl' in data) || (data.externalUrl is string && data.externalUrl.size() <= 400)) &&
        data.uploadedBy is string && data.uploadedBy.size() >= 1 && data.uploadedBy.size() <= 120 &&
        (!('unitTopic' in data) || (data.unitTopic is string && data.unitTopic.size() <= 160)) &&
        (!('tags' in data) || (
          data.tags is list &&
          data.tags.size() <= 15 &&
          (data.tags.size() == 0 || (data.tags[0] is string && data.tags[0].size() <= 40))
        )) &&
        (!('previewSnippet' in data) || (data.previewSnippet is string && data.previewSnippet.size() <= 2000)) &&
        data.downloadsCount is int && data.downloadsCount >= 0 && data.downloadsCount <= 1000000 &&
        data.createdByUid is string && isValidId(data.createdByUid) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidVirtualClassroomPost(data, roomCode) {
      return data.keys().hasAll([
          'roomCode',
          'authorId',
          'authorName',
          'authorRole',
          'content',
          'likes',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'roomCode',
          'authorId',
          'authorName',
          'authorRole',
          'content',
          'likes',
          'badge',
          'createdAt',
          'updatedAt'
        ]) &&
        data.roomCode is string && isValidVirtualRoomCode(data.roomCode) && data.roomCode == roomCode &&
        data.authorId is string && isValidId(data.authorId) &&
        data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 120 &&
        data.authorRole is string && data.authorRole in ['teacher', 'student'] &&
        data.content is string && data.content.size() >= 1 && data.content.size() <= 1000 &&
        data.likes is int && data.likes >= 0 && data.likes <= 100000 &&
        (!('badge' in data) || (data.badge is string && data.badge.size() <= 60)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // -------------------------------------------------------------------------
    // Admins Collection (Trusted RBAC Registry)
    // -------------------------------------------------------------------------
    match /admins/{adminUid} {
      allow get: if isValidId(adminUid) && (isOwner(adminUid) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(adminUid) &&
        isAdmin() &&
        isValidAdminRole(incoming(), adminUid) &&
        incoming().createdAt == request.time;
      allow update: if isValidId(adminUid) &&
        isAdmin() &&
        isValidAdminRole(incoming(), adminUid) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['email', 'role']);
      allow delete: if isValidId(adminUid) && isAdmin();
    }

    // -------------------------------------------------------------------------
    // Users Split Collections: Public Profile vs Private PII
    // -------------------------------------------------------------------------
    match /users/{userId}/public/{profileDocId} {
      allow get: if isValidId(userId) && isValidId(profileDocId) && (isOwner(userId) || isAdmin());
      allow list: if isValidId(userId) && isOwner(userId);
      allow create: if isValidId(userId) &&
        profileDocId == 'profile' &&
        isOwner(userId) &&
        isValidUserPublicProfile(incoming(), userId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time && (
          isAdmin() || (
            incoming().points >= 0 &&
            incoming().points <= 1000 &&
            (!('completedModulesCount' in incoming()) || (incoming().completedModulesCount >= 0 && incoming().completedModulesCount <= 4)) &&
            (!('streakDays' in incoming()) || (incoming().streakDays >= 0 && incoming().streakDays <= 30))
          )
        );
      allow update: if isValidId(userId) &&
        profileDocId == 'profile' &&
        isValidUserPublicProfile(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (
            isOwner(userId) &&
            incoming().points >= 0 &&
            incoming().points <= existing().points + 600 &&
            (!('completedModulesCount' in incoming()) || !('completedModulesCount' in existing()) || (
              incoming().completedModulesCount >= 0 &&
              incoming().completedModulesCount <= existing().completedModulesCount + 1 &&
              incoming().completedModulesCount <= 4
            )) &&
            (!('streakDays' in incoming()) || !('streakDays' in existing()) || incoming().streakDays <= existing().streakDays + 1) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName',
              'nickname',
              'avatarEmoji',
              'grade',
              'school',
              'points',
              'codingLevel',
              'selectedTitle',
              'streakDays',
              'completedModulesCount',
              'updatedAt'
            ])
          )
        );
      allow delete: if isValidId(userId) && isAdmin();
    }

    match /users/{userId}/private/{privateDocId} {
      allow get: if isValidId(userId) && isValidId(privateDocId) && (isOwner(userId) || isAdmin());
      allow list: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow create: if isValidId(userId) &&
        privateDocId == 'info' &&
        isOwner(userId) &&
        isValidUserPrivateInfo(incoming(), userId) &&
        incoming().role == 'student' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(userId) &&
        privateDocId == 'info' &&
        isValidUserPrivateInfo(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (
            isOwner(userId) &&
            incoming().role == existing().role &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'studentId',
              'contactEmail',
              'bio',
              'motto',
              'updatedAt'
            ])
          )
        );
      allow delete: if isValidId(userId) && isAdmin();
    }

    // -------------------------------------------------------------------------
    // Saved Flowcharts Subcollection
    // -------------------------------------------------------------------------
    match /users/{userId}/flowcharts/{flowchartId} {
      allow get: if isValidId(userId) && isValidId(flowchartId) && (isOwner(userId) || isAdmin());
      allow list: if isValidId(userId) && isEmailVerified() && resource.data.ownerId == request.auth.uid;
      allow create: if isValidId(userId) &&
        isValidId(flowchartId) &&
        isOwner(userId) &&
        isValidSavedFlowchart(incoming(), userId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(userId) &&
        isValidId(flowchartId) &&
        isValidSavedFlowchart(incoming(), userId) &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (
            isOwner(userId) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'title',
              'missionId',
              'templateId',
              'displayMode',
              'snapToGrid',
              'nodes',
              'updatedAt'
            ])
          )
        );
      allow delete: if isValidId(userId) && isValidId(flowchartId) && (isOwner(userId) || isAdmin());
    }

    // -------------------------------------------------------------------------
    // Cloud Studio Projects Subcollection (Scratch, Micro:bit, Python)
    // -------------------------------------------------------------------------
    match /users/{userId}/studioProjects/{studioProjectId} {
      allow get: if isValidId(userId) && isValidId(studioProjectId) && (isOwner(userId) || isAdmin());
      allow list: if isValidId(userId) && isEmailVerified() && resource.data.ownerId == request.auth.uid;
      allow create: if isValidId(userId) &&
        isValidId(studioProjectId) &&
        isOwner(userId) &&
        isValidStudioProject(incoming(), userId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(userId) &&
        isValidId(studioProjectId) &&
        isValidStudioProject(incoming(), userId) &&
        incoming().ownerId == existing().ownerId &&
        incoming().studioType == existing().studioType &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (
            isOwner(userId) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'title',
              'presetId',
              'codeContent',
              'blocksJson',
              'updatedAt'
            ])
          )
        );
      allow delete: if isValidId(userId) && isValidId(studioProjectId) && (isOwner(userId) || isAdmin());
    }

    // -------------------------------------------------------------------------
    // Showcase Projects & Peer Reviews
    // -------------------------------------------------------------------------
    match /showcaseProjects/{projectId} {
      allow get: if isValidId(projectId) && isEmailVerified() && (
        existing().status == 'published' ||
        existing().ownerId == request.auth.uid ||
        isAdmin()
      );
      allow list: if isEmailVerified() && resource.data.status == 'published';
      allow create: if isValidId(projectId) &&
        isEmailVerified() &&
        isValidShowcaseProject(incoming()) &&
        incoming().ownerId == request.auth.uid &&
        incoming().likesCount == 0 &&
        incoming().status == 'published' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(projectId) &&
        isEmailVerified() &&
        isValidShowcaseProject(incoming()) &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (
            existing().status != 'archived' &&
            existing().ownerId == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'title',
              'description',
              'projectUrl',
              'category',
              'status',
              'updatedAt'
            ])
          ) ||
          (
            existing().status == 'published' &&
            incoming().status == 'published' &&
            incoming().likesCount == existing().likesCount + 1 &&
            incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'updatedAt'])
          )
        );
      allow delete: if isValidId(projectId) && (
        (isEmailVerified() && existing().ownerId == request.auth.uid) ||
        isAdmin()
      );

      match /reviews/{reviewId} {
        allow get: if isValidId(projectId) && isValidId(reviewId) && isEmailVerified() &&
          exists(/databases/$(database)/documents/showcaseProjects/$(projectId));
        allow list: if isEmailVerified() && resource.data.projectId == projectId;
        allow create: if isValidId(projectId) &&
          isValidId(reviewId) &&
          isEmailVerified() &&
          isValidPeerReview(incoming(), projectId) &&
          incoming().reviewerId == request.auth.uid &&
          incoming().createdAt == request.time &&
          exists(/databases/$(database)/documents/showcaseProjects/$(projectId));
        allow update: if false;
        allow delete: if isValidId(projectId) && isValidId(reviewId) && (
          (isEmailVerified() && existing().reviewerId == request.auth.uid) ||
          isAdmin()
        );
      }
    }

    // -------------------------------------------------------------------------
    // Homework Submissions Collection (Student Submit + Teacher Rubric Grading)
    // -------------------------------------------------------------------------
    match /homeworkSubmissions/{submissionId} {
      allow get: if isValidId(submissionId) && isEmailVerified() && (
        existing().ownerId == request.auth.uid ||
        isAdmin()
      );
      allow list: if isEmailVerified() && (
        resource.data.ownerId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isValidId(submissionId) &&
        isEmailVerified() &&
        isValidHomeworkSubmission(incoming()) &&
        incoming().ownerId == request.auth.uid &&
        incoming().status == 'pending' &&
        !('gradeScore' in incoming()) &&
        !('teacherFeedback' in incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(submissionId) &&
        isEmailVerified() &&
        isValidHomeworkSubmission(incoming()) &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          (
            isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'status',
              'gradeScore',
              'teacherFeedback',
              'updatedAt'
            ])
          ) ||
          (
            existing().ownerId == request.auth.uid &&
            existing().status == 'pending' &&
            incoming().status == 'pending' &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'topic',
              'title',
              'projectUrl',
              'reflection',
              'updatedAt'
            ])
          )
        );
      allow delete: if isValidId(submissionId) && (
        (isEmailVerified() && existing().ownerId == request.auth.uid) ||
        isAdmin()
      );
    }

    // -------------------------------------------------------------------------
    // Live Classroom Quiz Battle Rooms & Participants
    // -------------------------------------------------------------------------
    match /liveRooms/{roomCode} {
      allow get: if isValidRoomCode(roomCode) && (
        isEmailVerified() ||
        resource == null ||
        existing().status in ['active', 'closed']
      );
      allow list: if isEmailVerified() && resource.data.status == 'active';
      allow create: if isValidRoomCode(roomCode) &&
        isAdmin() &&
        isValidLiveQuizRoom(incoming(), roomCode) &&
        incoming().hostUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidRoomCode(roomCode) &&
        isEmailVerified() &&
        isValidLiveQuizRoom(incoming(), roomCode) &&
        incoming().roomCode == existing().roomCode &&
        incoming().hostUid == existing().hostUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (
            existing().hostUid == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'hostName',
              'title',
              'stage',
              'currentQuestionIndex',
              'status',
              'platformSet',
              'difficulty',
              'questionCount',
              'questionIds',
              'totalParticipants',
              'finalTopWinners',
              'updatedAt'
            ])
          )
        );
      allow delete: if isValidRoomCode(roomCode) && (
        (isEmailVerified() && existing().hostUid == request.auth.uid) ||
        isAdmin()
      );

      match /participants/{participantId} {
        allow get: if isValidRoomCode(roomCode) && isValidId(participantId) && (
          isEmailVerified() ||
          isGuestParticipantId(participantId)
        ) && exists(/databases/$(database)/documents/liveRooms/$(roomCode));
        allow list: if isValidRoomCode(roomCode) && resource.data.roomCode == roomCode;
        allow create: if isValidRoomCode(roomCode) &&
          isValidId(participantId) &&
          (isOwner(participantId) || isGuestParticipantId(participantId)) &&
          isValidLiveQuizParticipant(incoming(), roomCode, participantId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          isActiveLiveRoom(roomCode) && (
            isAdmin() ||
            isLiveRoomHost(roomCode) ||
            (incoming().score == 0 && incoming().streak == 0 && incoming().lastAnswerIndex == -1)
          );
        allow update: if isValidRoomCode(roomCode) &&
          isValidId(participantId) &&
          isValidLiveQuizParticipant(incoming(), roomCode, participantId) &&
          incoming().roomCode == existing().roomCode &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time && (
            isAdmin() ||
            isLiveRoomHost(roomCode) ||
            (
              (isOwner(participantId) || isGuestParticipantId(participantId)) &&
              isLiveRoomAcceptingAnswers(roomCode) &&
              incoming().score >= existing().score &&
              incoming().score <= existing().score + 2000 &&
              incoming().streak >= 0 &&
              incoming().streak <= existing().streak + 1 &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'displayName',
                'avatar',
                'score',
                'streak',
                'lastAnswerIndex',
                'updatedAt'
              ])
            )
          );
        allow delete: if isValidRoomCode(roomCode) && isValidId(participantId) && (
          isLiveRoomHost(roomCode) ||
          isAdmin()
        );
      }
    }

    // -------------------------------------------------------------------------
    // Teacher PorPor 5 (ปพ.5) Assessment Records (Admin / Verified Teacher Only)
    // -------------------------------------------------------------------------
    match /porpor5Records/{recordId} {
      allow get: if isValidId(recordId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(recordId) &&
        isAdmin() &&
        isValidPorPor5Record(incoming()) &&
        incoming().teacherUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(recordId) &&
        isAdmin() &&
        isValidPorPor5Record(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'studentId',
          'name',
          'gradeRoom',
          'pdpaScore',
          'logicScore',
          'codingScore',
          'showcaseScore',
          'totalScore',
          'gradeLevel',
          'status',
          'teacherUid',
          'updatedAt'
        ]);
      allow delete: if isValidId(recordId) && isAdmin();
    }

    // -------------------------------------------------------------------------
    // Live Classroom Coding Battle Question Bank (Scratch & Micro:bit)
    // -------------------------------------------------------------------------
    match /battleQuestions/{questionId} {
      allow get: if isValidId(questionId) && (
        resource == null ||
        existing().status == 'active' ||
        isAdmin()
      );
      allow list: if isEmailVerified() && resource.data.status == 'active';
      allow create: if isValidId(questionId) &&
        isAdmin() &&
        isValidBattleQuestion(incoming()) &&
        incoming().createdByUid == request.auth.uid &&
        incoming().status == 'active' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(questionId) &&
        isAdmin() &&
        isValidBattleQuestion(incoming()) &&
        incoming().createdByUid == existing().createdByUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'platform',
          'difficulty',
          'title',
          'codeSnippet',
          'options',
          'correctIndex',
          'explanation',
          'status',
          'updatedAt'
        ]);
      allow delete: if isValidId(questionId) && isAdmin();
    }

    // -------------------------------------------------------------------------
    // Virtual Classrooms & Subcollections (Rooms, Members, Assignments, Schedules, Materials, Posts)
    // -------------------------------------------------------------------------
    match /virtualClassrooms/{roomCode} {
      allow get: if isValidVirtualRoomCode(roomCode) && (
        isEmailVerified() ||
        resource == null ||
        existing().status == 'active'
      );
      allow list: if isEmailVerified() && resource.data.status == 'active';
      allow create: if isValidVirtualRoomCode(roomCode) &&
        isAdmin() &&
        isValidVirtualClassroom(incoming(), roomCode) &&
        incoming().hostUid == request.auth.uid &&
        incoming().status == 'active' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidVirtualRoomCode(roomCode) &&
        isEmailVerified() &&
        isValidVirtualClassroom(incoming(), roomCode) &&
        incoming().roomCode == existing().roomCode &&
        incoming().hostUid == existing().hostUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (
            existing().hostUid == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'name',
              'teacherName',
              'grade',
              'school',
              'description',
              'studentsCount',
              'status',
              'updatedAt'
            ])
          )
        );
      allow delete: if isValidVirtualRoomCode(roomCode) && (
        isAdmin() ||
        (isEmailVerified() && existing().hostUid == request.auth.uid)
      );

      match /members/{memberId} {
        allow get: if isValidVirtualRoomCode(roomCode) && isValidId(memberId) && (
          isEmailVerified() ||
          isGuestParticipantId(memberId)
        ) && exists(/databases/$(database)/documents/virtualClassrooms/$(roomCode));
        allow list: if isValidVirtualRoomCode(roomCode) && resource.data.roomCode == roomCode;
        allow create: if isValidVirtualRoomCode(roomCode) &&
          isValidId(memberId) &&
          (isOwner(memberId) || isGuestParticipantId(memberId) || isAdmin() || isVirtualRoomHost(roomCode)) &&
          isValidVirtualClassroomMember(incoming(), roomCode, memberId) &&
          (incoming().role == 'student' || isAdmin() || isVirtualRoomHost(roomCode)) &&
          incoming().joinedAt == request.time &&
          incoming().updatedAt == request.time &&
          isActiveVirtualRoom(roomCode);
        allow update: if isValidVirtualRoomCode(roomCode) &&
          isValidId(memberId) &&
          isValidVirtualClassroomMember(incoming(), roomCode, memberId) &&
          incoming().roomCode == existing().roomCode &&
          incoming().memberId == existing().memberId &&
          incoming().joinedAt == existing().joinedAt &&
          incoming().updatedAt == request.time &&
          isActiveVirtualRoom(roomCode) && (
            isAdmin() ||
            isVirtualRoomHost(roomCode) ||
            (
              (isOwner(memberId) || isGuestParticipantId(memberId)) &&
              incoming().role == existing().role &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'displayName',
                'avatarEmoji',
                'updatedAt'
              ])
            )
          );
        allow delete: if isValidVirtualRoomCode(roomCode) && isValidId(memberId) && (
          isAdmin() ||
          isVirtualRoomHost(roomCode) ||
          isOwner(memberId)
        );
      }

      match /assignments/{assignmentId} {
        allow get: if isValidVirtualRoomCode(roomCode) &&
          isValidId(assignmentId) &&
          exists(/databases/$(database)/documents/virtualClassrooms/$(roomCode));
        allow list: if isValidVirtualRoomCode(roomCode) && resource.data.roomCode == roomCode;
        allow create: if isValidVirtualRoomCode(roomCode) &&
          isValidId(assignmentId) &&
          (isAdmin() || isVirtualRoomHost(roomCode)) &&
          isValidVirtualClassroomAssignment(incoming(), roomCode) &&
          incoming().createdByUid == request.auth.uid &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          exists(/databases/$(database)/documents/virtualClassrooms/$(roomCode));
        allow update: if isValidVirtualRoomCode(roomCode) &&
          isValidId(assignmentId) &&
          (isAdmin() || isVirtualRoomHost(roomCode)) &&
          isValidVirtualClassroomAssignment(incoming(), roomCode) &&
          incoming().roomCode == existing().roomCode &&
          incoming().createdByUid == existing().createdByUid &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'title',
            'moduleKey',
            'dueDate',
            'teacherNote',
            'rewardPoints',
            'maxScore',
            'updatedAt'
          ]);
        allow delete: if isValidVirtualRoomCode(roomCode) &&
          isValidId(assignmentId) &&
          (isAdmin() || isVirtualRoomHost(roomCode));
      }

      match /submissions/{submissionId} {
        allow get: if isValidVirtualRoomCode(roomCode) && isValidId(submissionId) && (
          isAdmin() ||
          isVirtualRoomHost(roomCode) ||
          isOwner(existing().studentMemberId) ||
          isGuestParticipantId(existing().studentMemberId)
        );
        allow list: if isValidVirtualRoomCode(roomCode) &&
          resource.data.roomCode == roomCode && (
            isAdmin() ||
            (isEmailVerified() && resource.data.studentMemberId == request.auth.uid) ||
            isGuestParticipantId(resource.data.studentMemberId)
          );
        allow create: if isValidVirtualRoomCode(roomCode) &&
          isValidId(submissionId) &&
          isValidVirtualClassroomSubmission(incoming(), roomCode) &&
          (isOwner(incoming().studentMemberId) || isGuestParticipantId(incoming().studentMemberId)) &&
          incoming().status == 'submitted' &&
          !('score' in incoming()) &&
          !('teacherFeedback' in incoming()) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          isActiveVirtualRoom(roomCode);
        allow update: if isValidVirtualRoomCode(roomCode) &&
          isValidId(submissionId) &&
          isValidVirtualClassroomSubmission(incoming(), roomCode) &&
          incoming().roomCode == existing().roomCode &&
          incoming().assignmentId == existing().assignmentId &&
          incoming().studentMemberId == existing().studentMemberId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time && (
            (isAdmin() || isVirtualRoomHost(roomCode)) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'status',
              'score',
              'teacherFeedback',
              'updatedAt'
            ])
          );
        allow delete: if isValidVirtualRoomCode(roomCode) &&
          isValidId(submissionId) &&
          (isAdmin() || isVirtualRoomHost(roomCode));
      }

      match /schedules/{scheduleId} {
        allow get: if isValidVirtualRoomCode(roomCode) &&
          isValidId(scheduleId) &&
          exists(/databases/$(database)/documents/virtualClassrooms/$(roomCode));
        allow list: if isValidVirtualRoomCode(roomCode) && resource.data.roomCode == roomCode;
        allow create: if isValidVirtualRoomCode(roomCode) &&
          isValidId(scheduleId) &&
          (isAdmin() || isVirtualRoomHost(roomCode)) &&
          isValidVirtualClassroomSchedule(incoming(), roomCode) &&
          incoming().createdByUid == request.auth.uid &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          exists(/databases/$(database)/documents/virtualClassrooms/$(roomCode));
        allow update: if isValidVirtualRoomCode(roomCode) &&
          isValidId(scheduleId) &&
          (isAdmin() || isVirtualRoomHost(roomCode)) &&
          isValidVirtualClassroomSchedule(incoming(), roomCode) &&
          incoming().roomCode == existing().roomCode &&
          incoming().createdByUid == existing().createdByUid &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'dayOfWeek',
            'dayLabel',
            'startTime',
            'endTime',
            'period',
            'subjectCode',
            'subjectName',
            'topic',
            'unitTitle',
            'roomLocation',
            'teacherName',
            'onlineMeetUrl',
            'colorTheme',
            'updatedAt'
          ]);
        allow delete: if isValidVirtualRoomCode(roomCode) &&
          isValidId(scheduleId) &&
          (isAdmin() || isVirtualRoomHost(roomCode));
      }

      match /materials/{materialId} {
        allow get: if isValidVirtualRoomCode(roomCode) &&
          isValidId(materialId) &&
          exists(/databases/$(database)/documents/virtualClassrooms/$(roomCode));
        allow list: if isValidVirtualRoomCode(roomCode) && resource.data.roomCode == roomCode;
        allow create: if isValidVirtualRoomCode(roomCode) &&
          isValidId(materialId) &&
          (isAdmin() || isVirtualRoomHost(roomCode)) &&
          isValidVirtualClassroomMaterial(incoming(), roomCode) &&
          incoming().createdByUid == request.auth.uid &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          exists(/databases/$(database)/documents/virtualClassrooms/$(roomCode));
        allow update: if isValidVirtualRoomCode(roomCode) &&
          isValidId(materialId) &&
          isValidVirtualClassroomMaterial(incoming(), roomCode) &&
          incoming().roomCode == existing().roomCode &&
          incoming().createdByUid == existing().createdByUid &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time && (
            isAdmin() ||
            isVirtualRoomHost(roomCode) ||
            (
              isActiveVirtualRoom(roomCode) &&
              incoming().downloadsCount == existing().downloadsCount + 1 &&
              incoming().diff(existing()).affectedKeys().hasOnly(['downloadsCount', 'updatedAt'])
            )
          );
        allow delete: if isValidVirtualRoomCode(roomCode) &&
          isValidId(materialId) &&
          (isAdmin() || isVirtualRoomHost(roomCode));
      }

      match /posts/{postId} {
        allow get: if isValidVirtualRoomCode(roomCode) &&
          isValidId(postId) &&
          exists(/databases/$(database)/documents/virtualClassrooms/$(roomCode));
        allow list: if isValidVirtualRoomCode(roomCode) && resource.data.roomCode == roomCode;
        allow create: if isValidVirtualRoomCode(roomCode) &&
          isValidId(postId) &&
          isActiveVirtualRoom(roomCode) &&
          isValidVirtualClassroomPost(incoming(), roomCode) &&
          (isOwner(incoming().authorId) || isGuestParticipantId(incoming().authorId)) &&
          (incoming().authorRole == 'student' || isAdmin() || isVirtualRoomHost(roomCode)) &&
          incoming().likes == 1 &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time;
        allow update: if isValidVirtualRoomCode(roomCode) &&
          isValidId(postId) &&
          isActiveVirtualRoom(roomCode) &&
          isValidVirtualClassroomPost(incoming(), roomCode) &&
          incoming().roomCode == existing().roomCode &&
          incoming().authorId == existing().authorId &&
          incoming().authorRole == existing().authorRole &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time && (
            isAdmin() ||
            isVirtualRoomHost(roomCode) ||
            (
              incoming().likes == existing().likes + 1 &&
              incoming().diff(existing()).affectedKeys().hasOnly(['likes', 'updatedAt'])
            )
          );
        allow delete: if isValidVirtualRoomCode(roomCode) && isValidId(postId) && (
          isAdmin() ||
          isVirtualRoomHost(roomCode) ||
          isOwner(existing().authorId)
        );
      }
    }
  }
}
